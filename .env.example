# Личный бакет и профиль с уже настроенными ключами.
S3_BUCKET=
# AWS_PROFILE=default
S3_ENDPOINT_URL=https://storage.yandexcloud.net

# При необходимости можно изменить локальный каталог сервиса.
RECOMMENDATIONS_DIR=data/recommendations

# Для Windows можно использовать существующее подключение CS Browser.
# S3_BROWSER_ACCOUNT="Имя подключения"
# S3_BROWSER_CLI="C:\Program Files\CS Browser\s3browser-cli.exe"
